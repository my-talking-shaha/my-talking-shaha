# Copy this file to .env for local Docker runs and replace every placeholder.
# These values are examples only. Do not reuse them for shared, staging, or production-like deployments.
JWT_SECRET=replace-me-with-at-least-32-random-bytes
DB_USERNAME=replace-me
DB_PASSWORD=replace-me
TIMEWEB_AI_BASE_URL=https://agent.timeweb.cloud/api/v1/cloud-ai/agents/YOUR_AGENT_ID/v1
TIMEWEB_AI_TOKEN=replace-me
TIMEWEB_AI_MODEL=timeweb-agent
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
